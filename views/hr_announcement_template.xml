<odoo>

    <record id="hr_announcement_template_form" model="ir.ui.view">
        <field name="name">hr.announcement.template.form</field>
        <field name="model">hr.announcement.template</field>
        <field name="arch" type="xml">
            <form>
            
                <sheet>
                    <h1>
                        <field name="name" placeholder="Template Name"/>
                    </h1>

                    <field name="attachment_id" widget="many2many_binary"/>
                    
                    <notebook>
                        <page string="Template">
                            <field name="template"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

</odoo>