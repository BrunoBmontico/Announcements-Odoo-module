<odoo>

    <record id="hr_announcement_modal" model="ir.ui.view">
        <field name="name">hr.announcement.modal.wizard</field>
        <field name="model">hr.announcement.modal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="announcement_template_id" invisible="1"/>
                        <field name="announcement" nolabel="1"/>
                    </group>

                    <group>
                        <field name="attachment_id" widget="image_carousel" nolabel="1"/>
                    </group>
                </sheet>    
            </form>
        </field>
    </record>

    <record id="action_hr_announcement_modal" model="ir.actions.act_window">
        <field name="name">Announcement</field>
        <field name="res_model">hr.announcement.modal</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>